      "title": "Evidence Sha256",
      "type": "string"
    },
    "license_source": {
      "minLength": 1,
      "title": "License Source",
      "type": "string"
    },
    "license_url": {
      "pattern": "^https://",
      "title": "License Url",
      "type": "string"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "redistribution_allowed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Redistribution Allowed"
