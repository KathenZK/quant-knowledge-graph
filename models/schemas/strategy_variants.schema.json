    "strategy_id": {
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_template_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Strategy Template Id"
    },
    "strategy_variant_id": {
      "title": "Strategy Variant Id",
      "type": "string"
    },
    "terms_url": {
      "title": "Terms Url",
      "type": "string"
