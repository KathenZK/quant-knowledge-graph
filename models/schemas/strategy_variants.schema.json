      "type": "string"
    },
    "spec_sha256": {
      "title": "Spec Sha256",
      "type": "string"
    },
    "strategy_concept_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
