{
  "$defs": {
    "Permission": {
      "enum": [
        "ALLOWED",
        "CONDITIONAL",
        "PROHIBITED",
        "REVIEW_REQUIRED"
      ],
      "title": "Permission",
      "type": "string"
    },
    "StrategyProvenance": {
      "enum": [
        "SOURCE_NATIVE",
        "SOURCE_IMPLEMENTATION",
        "SOURCE_DERIVED",
        "BOT_DERIVED",
        "PARAMETER_VARIANT",
        "MARKET_VARIANT",
        "ASSET_VARIANT",
        "UNKNOWN"
