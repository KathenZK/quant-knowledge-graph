    "terms_url",
    "strategy_variant_id",
    "strategy_id",
    "strategy_concept_id",
    "strategy_template_id",
    "source_id",
    "source_native_id",
    "source_sha256",
    "source_locator",
    "original_rule_text",
    "normalized_rule",
    "rule_ast",
