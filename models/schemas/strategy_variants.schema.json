      "type": "object"
    },
    "commercial_use": {
      "$ref": "#/$defs/Permission"
    },
    "concept_origin_date": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Concept Origin Date"
    },
    "date_status": {
      "const": "UNVERIFIED_REPORTED_DATE",
      "default": "UNVERIFIED_REPORTED_DATE",
      "title": "Date Status",
      "type": "string"
    },
    "derivative_allowed": {
      "$ref": "#/$defs/Permission"
    },
    "executable": {
      "const": false,
