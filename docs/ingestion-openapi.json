  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestBatch": {
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "batch_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Batch Id"
          },
          "collector_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Collector Version"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/IngestRecord"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "batch_id",
          "collector_version",
          "records"
        ],
        "title": "IngestBatch"
      },
      "IngestRecord": {
        "properties": {
          "metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Metadata"
          },
          "record_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Record Id"
          },
          "source_url": {
            "type": "string",
            "maxLength": 4000,
            "title": "Source Url"
          },
          "name": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Name"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          },
          "source_publication_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Publication Date"
          },
          "raw_market": {
            "type": "string",
            "maxLength": 2000,
