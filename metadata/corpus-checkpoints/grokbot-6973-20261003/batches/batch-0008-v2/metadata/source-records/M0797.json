    "名称": {
      "status": "CATALOG_REPORTED_UNVERIFIED",
      "value": "标普500百分之二虚值备兑：多头标普500并卖出月度认购，行权价最接近11:00美东前标普500最后值的102%"
    },
    "市场": {
