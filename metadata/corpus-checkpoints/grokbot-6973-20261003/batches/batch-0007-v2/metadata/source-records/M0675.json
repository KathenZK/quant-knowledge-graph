    "名称": {
      "status": "CATALOG_REPORTED_UNVERIFIED",
      "value": "格林布拉特魔法公式：盈利收益率与资本回报率，每年持有20至30只"
    },
    "市场": {
      "status": "CATALOG_REPORTED_UNVERIFIED",
